# Railway Environment Variables
# 复制以下内容到 Railway 的环境变量配置中

# Server
HOST=0.0.0.0
PORT=1337

# Secrets
APP_KEYS=replace_with_app_keys
API_TOKEN_SALT=replace_with_api_token_salt
ADMIN_JWT_SECRET=replace_with_admin_jwt_secret
TRANSFER_TOKEN_SALT=replace_with_transfer_token_salt
ENCRYPTION_KEY=replace_with_encryption_key
JWT_SECRET=replace_with_jwt_secret

# Database
DATABASE_CLIENT=postgres
DATABASE_URL=replace_with_railway_postgres_url
DATABASE_SSL=false
DATABASE_SCHEMA=public

# AI
QWEN_API_KEY=replace_with_qwen_api_key

# Aliyun OSS
OSS_ACCESS_KEY_ID=replace_with_access_key_id
OSS_ACCESS_KEY_SECRET=replace_with_access_key_secret
OSS_REGION=oss-cn-hongkong
OSS_BUCKET=replace_with_bucket_name
OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com
